{
  "name": "patricks-world",
  "version": "0.1.0",
  "description": "An explorable world of projects and ideas, drawn as a survey atlas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sync:github": "node scripts/github-fetch.mjs",
    "sync:local": "node scripts/local-fetch.mjs",
    "sync:skill": "node scripts/skill-sync.mjs",
    "install:skill": "node scripts/skill-install.mjs",
    "world:export": "node scripts/world-export.mjs",
    "world:build": "node mockups/build.mjs",
    "world:serve": "node mockups/serve.mjs",
    "world": "node scripts/world-export.mjs && node mockups/build.mjs && node mockups/serve.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run && vite build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/besley": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true
}
